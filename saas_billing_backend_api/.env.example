# Copy to .env and fill in. NEVER commit .env.
# Local Docker:  docker compose up -d --build

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Include "web" so the stripe-cli container can reach the API.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend origin(s) allowed to call the API (production: https://app.example.com)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the React app, used in invitation emails
FRONTEND_URL=http://localhost:5173
# True only behind an HTTPS proxy that sets X-Forwarded-Proto
USE_X_FORWARDED_PROTO=False

# --- PostgreSQL ---------------------------------------------------------------
DB_NAME=saas_billing
DB_USER=saas_billing
DB_PASSWORD=change-me
# Only used outside Docker (compose sets DB_HOST=postgres):
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Celery) - only used outside Docker ---------------------------------
REDIS_URL=redis://127.0.0.1:6380/0
# Shared cache for rate limits / login lockout (empty = in-process memory)
# REDIS_CACHE_URL=redis://127.0.0.1:6380/1

# --- Security tuning (defaults shown) --------------------------------------------
# THROTTLE_AUTH_RATE=30/min
# THROTTLE_REGISTER_RATE=10/hour
# LOGIN_MAX_FAILURES_PER_IP_EMAIL=5
# LOGIN_MAX_FAILURES_PER_EMAIL=20
# LOGIN_LOCKOUT_SECONDS=900
# NUM_PROXIES=0
# LOG_FORMAT=text

# --- Stripe (TEST mode keys for development) -----------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
# docker compose run --rm stripe-cli listen --api-key %STRIPE_SECRET_KEY% --print-secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:5173/subscriptions?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/subscriptions?checkout=cancel

# --- Email (optional; console backend by default) ------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com
