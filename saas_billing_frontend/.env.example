# Optional. Base URL of the Django API as seen by the browser.
# Default "/api": Vite (dev) and nginx (production) proxy it to Django, so
# the httpOnly refresh cookie stays first-party. Only set an absolute URL
# if the API is on another origin (then cookies must be SameSite=None).
VITE_API_BASE_URL=/api

# Dev only: where the Vite proxy forwards /api (default http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
