# Copy to deploy/.env.prod (git-ignored) and fill in. Never commit it.

# Public hostname (DNS A record -> this server). Caddy gets HTTPS for it.
DOMAIN=demo.example.com

# --- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=demo.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://demo.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://demo.example.com
FRONTEND_URL=https://demo.example.com
SECURE_SSL_REDIRECT=True

# --- Database (container) -------------------------------------------------
DB_NAME=saas_billing
DB_USER=saas_billing
DB_PASSWORD=generate-a-strong-password

# --- Stripe: TEST keys for a public demo -----------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://demo.example.com/subscriptions?checkout=success
STRIPE_CANCEL_URL=https://demo.example.com/subscriptions?checkout=cancel

# --- Live demo -----------------------------------------------------------
# DEMO_MODE=true shows one-click demo logins and resets the data nightly.
DEMO_MODE=true
SEED_DEMO=true
DEMO_PASSWORD=DemoPass123!
# Optional Stripe test price IDs so "Upgrade" works in the demo:
# DEMO_STRIPE_PRO_MONTHLY_PRICE=price_xxx
# DEMO_STRIPE_PRO_ANNUAL_PRICE=price_xxx

# --- Email (optional) ----------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
